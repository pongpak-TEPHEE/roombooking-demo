# ---- Server ----
NODE_ENV=production
PORT=3000
TZ=Asia/Bangkok

# Frontend URL (used for CORS and the room QR-code links). May include a path.
FRONTEND_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ---- Auth ----
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# ---- Demo mode ----
# true = passwordless demo login, no outgoing e-mail, nightly data reset
DEMO_MODE=true
# true = wipe and re-seed the database every time the server starts
DEMO_RESET_ON_START=false

# ---- E-mail (only used when DEMO_MODE is not true) ----
EMAIL_USER=
EMAIL_PASS=
