# Backend API URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# true = show the demo login (role buttons) instead of the e-mail OTP form
VITE_DEMO_MODE=true

# Sub-path the app is served from ("/" locally, "/roombooking-demo/" on GitHub Pages)
VITE_BASE_PATH=/

# Optional: Google Calendar API key for the Thai public-holiday overlay
VITE_GOOGLE_CALENDAR_API_KEY=
